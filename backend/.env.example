# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB Atlas (MONGODB_URI is the preferred name; MONGO_URI also works for backwards compatibility)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/cowcare?retryWrites=true&w=majority

# JWT
JWT_ACCESS_SECRET=replace_with_long_random_secret
JWT_REFRESH_SECRET=replace_with_another_long_random_secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Cattle ID prefix defaults
CATTLE_ID_COUNTRY=IND

# Uploads
MAX_UPLOAD_MB=5

# Emergency escalation - minutes an EMERGENCY request can sit unaccepted
# before it's re-broadcast more widely (including to opted-in off-duty vets)
EMERGENCY_ESCALATION_MINUTES=10

# Google Gemini AI (Server-side key for plain-language farmer summaries & clinical co-pilot)
GEMINI_API_KEY=your_gemini_api_key_here
