# Frontend Environment Variables (Vercel deployment)

# Production backend API base URL (Render backend)
# In production on Vercel, set this to: https://cowcare-v1.onrender.com/api
# In local development, leave empty to default to /api (proxied by Vite)
VITE_API_BASE_URL=https://cowcare-v1.onrender.com/api

# Production backend origin (for Socket.IO real-time notifications and legacy image resolution)
# In production on Vercel, set this to: https://cowcare-v1.onrender.com
# In local development, leave empty to default to / (proxied by Vite)
VITE_BACKEND_URL=https://cowcare-v1.onrender.com
